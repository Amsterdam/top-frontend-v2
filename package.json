{
  "name": "top-frontend-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.0"
  },
  "scripts": {
    "start": "vite",
    "acc": "vite --mode acceptance",
    "build": "tsc -b && vite build",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "generate:api-schema:local": "npx --yes openapi-typescript http://localhost:8000/api/v1/schema/ -o ./src/__generated__/apiSchema.d.ts",
    "generate:api-schema:acc": "npx --yes openapi-typescript https://acc.api.top.amsterdam.nl/api/v1/schema/ -o ./src/__generated__/apiSchema.d.ts"
  },
  "dependencies": {
    "@amsterdam/design-system-assets": "^2.5.0",
    "@amsterdam/design-system-css": "^4.3.0",
    "@amsterdam/design-system-react": "^4.3.0",
    "@amsterdam/design-system-react-icons": "^2.2.0",
    "@amsterdam/design-system-tokens": "^4.2.0",
    "@amsterdam/ee-ads-rhf": "^0.0.5",
    "@dnd-kit/sortable": "^10.0.0",
    "@tanstack/react-query": "^5.101.4",
    "dayjs": "^1.11.19",
    "jwt-decode": "^4.0.0",
    "lodash.debounce": "^4.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-oidc-context": "^3.3.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.20",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^26.0.0",
    "@types/qs": "^6.15.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.3.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.5",
    "vitest": "^4.0.15"
  }
}
